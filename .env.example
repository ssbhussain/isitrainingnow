# Public Supabase project URL (SiteSpecCalc project is reused for iirn_* tables).
NEXT_PUBLIC_SUPABASE_URL=

# Publishable anon key. Safe for the browser. Never put the service role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only OpenAI key (gpt-4o-mini).
OPENAI_API_KEY=

# Public AdSense publisher id, reused from sitespeccalc.com.
NEXT_PUBLIC_ADSENSE_PUB_ID=ca-pub-3430684260439635

# Mediavine Grow site id for isitrainingnow.in only.
# Leave blank until the new site-specific Grow ID is pasted in.
# Do not reuse the SiteSpecCalc Grow ID.
NEXT_PUBLIC_GROW_SITE_ID=

# Vercel Cron sends this as Authorization: Bearer. Use a long random string.
# Required for /api/cron/sync-global-weather.
CRON_SECRET=
